public class BrainSupportSimulator {
    public static void main(String[] args) {
        System.out.println("╔═══════════════════════════════════════════════╗");
        System.out.println("║       BRAIN-SUPPORT SUBSCRIPTION SYSTEM      ║");
        System.out.println("╚═══════════════════════════════════════════════╝");
        
        BrainSupportService patient = new BrainSupportService("P-001");
        
        // Initial state
        patient.printCurrentTier();
        
        // Test Common tier coverage
        patient.travelCheck(5);   // Within range
        patient.travelCheck(15);  // Out of range - UNSTABLE
        patient.travelCheck(0);   // Back in coverage
        
        // Test mood control on Common (should fail)
        patient.setMood("happy");
        
        // Promote to Plus
        patient.promote();
        patient.printCurrentTier();
        patient.travelCheck(30);  // Within Plus range
        patient.travelCheck(60);  // Out of range - UNSTABLE
        patient.travelCheck(0);   // Back in coverage
        
        // Promote to Lux
        patient.promote();
        patient.printCurrentTier();
        patient.travelCheck(40);  // Within Lux range
        
        // Test mood control on Lux (should work)
        patient.setMood("calm");
        patient.setMood("happy");
        patient.setMood("exhausted");
        
        // Demote back to Plus
        patient.demote();
        patient.printCurrentTier();
        
        // Test mood control on Plus (should fail)
        patient.setMood("happy");
        
        // Test activateLux from Plus (2 seconds as demo)
        patient.activateLux(2);
        patient.printCurrentTier();
        
        // During Lux activation, test mood
        System.out.println("\n--- Testing during temporary Lux activation ---");
        patient.promote(); // Back to Lux permanently
        patient.activateLux(1); // Test activating Lux while in Lux
        
        System.out.println("\n╔═══════════════════════════════════════════════╗");
        System.out.println("║           END OF SIMULATION                  ║");
        System.out.println("╚═══════════════════════════════════════════════╝");
    }
}
